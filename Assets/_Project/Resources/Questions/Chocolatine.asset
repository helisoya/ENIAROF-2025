  ID: Chocolatine
  isFirstQuestion: 0
  label: "Pr\xE9f\xE9rez-vous les pains au chocolat ou les chocolatines ?"
  requirements: []
  anwsers:
  - ID: Chocolatine_1
    label: "Les pains au chocolat, le reste devrait \xEAtre puni"
    actions:
    - AddPoolScore(Masc_Fin_Negatif;1)
    - AddPoolScore(Fem_Fin_Negatif;1)
    - AddElement(SET_horreur;1)
  - ID: Chocolatine_2
    label: Les chocolatines, c'est logique !
    actions:
    - AddPoolScore(Masc_Fin_Positif;1)
    - AddPoolScore(Fem_Fin_Positif;1)
    - AddElement(SET_fantasy;1)
  - ID: Chocolatine_3
    label: "Les chocolatines au chocolat, bien s\xFBr"
    actions:
    - AddPoolScore(Fin_2_Neutre;1)
    - AddElement(DEC_Shapes_FRONT;1)
  - ID: Chocolatine_4
    label: "Les pains aux chocolatines, \xE7a ne fait aucun doute"
    actions:
    - AddPoolScore(Fin_2_Neutre;1)
    - AddElement(DEC_Shapes_FRONT;1)
  - ID: Chocolatine_5
    label: Les chocolatines au pain, quoi d'autre ?
    actions:
    - AddPoolScore(Fin_2_Neutre;1)
    - AddElement(DEC_Shapes_FRONT;1)
  - ID: Chocolatine_6
    label: Les pains au pain, en fait
    actions:
    - AddPoolScore(Masc_Fin_Negatif;1)
    - AddPoolScore(Fem_Fin_Negatif;1)
    - AddPoolScore(Fin_1_Negatif;1)
    - "AddPoolScore(Fin_2_N\xE9gatif;1)"
    - AddElement(SET_horreur;1)
